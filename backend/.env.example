# Run the backend with Node.js 22.13 or newer (the project uses node:sqlite).
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
API_PREFIX=/api/v1

# Paths are resolved from the backend directory.
DATABASE_PATH=./storage/case-study-tool.sqlite
REPORT_STORAGE_DIR=./storage/reports
UPLOAD_STORAGE_DIR=./storage/uploads

# Development placeholder. Set a randomly generated value of at least 32
# characters before deploying; production rejects this placeholder.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=7

# Optional. Public repositories work without a token, subject to GitHub limits.
GITHUB_TOKEN=

# Optional providers. The app remains usable without either key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=8000
TAVILY_API_KEY=
