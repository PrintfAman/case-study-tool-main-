# Run the backend with Node.js 22.13 or newer (the project uses node:sqlite).
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
API_PREFIX=/api/v1

# Local development uses SQLite and local files when DATABASE_URL and the
# Supabase Storage credentials are omitted. Production must use Supabase.
DATABASE_PATH=./storage/case-study-tool.sqlite
REPORT_STORAGE_DIR=./storage/reports
UPLOAD_STORAGE_DIR=./storage/uploads

# Supabase: use the Session pooler connection string in Render (IPv4 compatible).
# Keep these server-only; never add them to frontend/VITE_* variables.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Older projects may use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=case-study-files

# Optional. Public repositories work without a token, subject to GitHub limits.
GITHUB_TOKEN=

# Groq handles analysis, field enrichment, chat, chat reranking, and report edits.
# The app keeps deterministic source-based fallbacks when Groq is not configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=8000
# Project knowledge uses local hashed-token vectors, then Groq reranks candidates.
TAVILY_API_KEY=
